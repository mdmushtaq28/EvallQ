# ==============================================================================
# FocusFlow AI — Local Container Deployment Configuration
# ==============================================================================

# Application Metadata
APP_NAME=FocusFlow AI API
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# Persistent SQLite Storage
# In container deployment, SQLite database is mounted at /app/data/focusflow.db
DATABASE_URL=sqlite:////app/data/focusflow.db

# Frontend URL (Served via Nginx on port 80)
FRONTEND_URL=http://localhost

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost", "http://127.0.0.1", "http://localhost:5173", "http://127.0.0.1:5173"]

# Hardware Target Reporting (Truthful unvalidated status preserved)
TARGET_PLATFORM=Snapdragon AI PC
DEV_ENVIRONMENT=Host CPU / x86_64
AI_TARGET=host
SNAPDRAGON_DEVICE=Snapdragon X Series
SNAPDRAGON_NPU_RUNTIME=QNN / ONNX Runtime
SNAPDRAGON_VALIDATED=false

# Local LLM Inference Engine (Ollama Service on Docker Network)
LLM_PROVIDER=development
LLM_MODEL=qwen2.5:0.5b
LLM_BASE_URL=http://ollama:11434
LLM_TIMEOUT_SECONDS=60.0
LLM_DEV_DEVICE=Host CPU (x86_64)
LLM_TARGET_DEVICE=Qualcomm Hexagon NPU (Snapdragon)
